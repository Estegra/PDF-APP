<ui:FluentWindow x:Class="PDF_APP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
        xmlns:local="clr-namespace:PDF_APP"
        mc:Ignorable="d"
        FontFamily="Segoe UI"
        Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        Background="Transparent"
        ExtendsContentIntoTitleBar="True"
        Icon="/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="" />

        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    IsHitTestVisible="False">

            <Image Source="/icon.ico"
                   Width="20" Height="20"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <TextBlock Text="PDF Araç Kutusu"
                       FontStyle="Italic"
                       FontSize="12"
                       FontWeight="Medium"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="MergeSuccessOverlay" Grid.Column="0"
                Background="#057d15" Margin="3"
                CornerRadius="8"
                Opacity="0" 
                IsHitTestVisible="False"/>
            <ui:Card Grid.Column="0" 
                     VerticalAlignment="Stretch"
                     AllowDrop="True" 
                     Drop="MergeZone_Drop" 
                     >
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="DocumentCopy24" FontSize="50" Margin="0,0,0,10"/>
                        <TextBlock Text="PDF BİRLEŞTİR" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Dosyaları sürükle ve bırak" FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
                    </StackPanel>

                    
                </Grid>
            </ui:Card>

            <Border x:Name="SplitSuccessOverlay" Grid.Column="2"
                Background="#057d15" Margin="3"
                CornerRadius="8"
                Opacity="0"
                IsHitTestVisible="False"/>
            <ui:Card Grid.Column="2" 
                     VerticalAlignment="Stretch"
                     AllowDrop="True" 
                     Drop="SplitZone_Drop"
                     >
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Cut24" FontSize="50" Margin="0,0,0,10"/>
                        <TextBlock Text="PDF PARÇALA" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tek dosyayı sürükle ve bırak" FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
                    </StackPanel>

                    
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>